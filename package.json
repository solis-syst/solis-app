{
  "name": "solis",
  "version": "0.1.0",
  "description": "Solis chess analyzer",
  "main": "electron/main.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/solis-syst/solis-app.git"
  },
  "scripts": {
    "start": "electron .",
    "build:sidecar": "dotnet publish sidecar/CursorSidecar.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o sidecar/publish",
    "dist": "npm run build:sidecar && electron-builder --win nsis --publish never",
    "release": "npm run build:sidecar && electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.solis.chess",
    "productName": "Solis",
    "asar": true,
    "win": {
      "target": "nsis",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "differentialPackage": true
    },
    "publish": {
      "provider": "github",
      "owner": "solis-syst",
      "repo": "solis-app-updates",
      "releaseType": "draft",
      "publishAutoUpdate": true
    },
    "extraResources": [
      {
        "from": "sidecar/publish",
        "to": "sidecar"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.4.4",
    "electron-builder": "26.16.1"
  }
}
